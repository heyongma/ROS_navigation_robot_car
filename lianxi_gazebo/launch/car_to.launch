<launch>
  <param name="robot_description"
command="$(find xacro)/xacro $(find lianxi_gazebo)/urdf/car_to.urdf.xacro" />

<include file="$(find gazebo_ros)/launch/empty_world.launch">
<arg name="world_name" value="$(find lianxi_slam)/world/box_house.world"/>
</include>


<node name="spawn_model" pkg="gazebo_ros" type="spawn_model"
args="-urdf -model car_to -param robot_description -x 0.0 -y 0.0 -Y 3.1416 -z 0.05"
output="screen" />

<node name="robot_state_publisher" pkg="robot_state_publisher"
type="robot_state_publisher" output="screen"/>
</launch>
