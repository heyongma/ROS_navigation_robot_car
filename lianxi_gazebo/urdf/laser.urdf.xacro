<?xml version="1.0"?>
<xacro:macro name="laser_block" xmlns:xacro="http://wiki.ros.org/xacro">
<xacro:property name="support_radius" value="0.012"/>
<xacro:property name="support_length" value="0.16"/>
<xacro:property name="support_mass" value="0.02"/>
<xacro:property name="laser_radius" value="0.024"/>
<xacro:property name="laser_length" value="0.03"/>
<xacro:property name="laser_mass" value="0.05"/>
<link name="support">
<visual>
<geometry>
<cylinder radius="${support_radius}" length="${support_length}"/>
</geometry>
<origin xyz="0 0 0" rpy="0 0 0"/>
<material name="support_color">
<color rgba="0.8 0.5 0.0 1.0"/>
</material>
</visual>
<collision>
<geometry>
<cylinder radius="${support_radius}" length="${support_length}"/>
</geometry>
<origin xyz="0 0 0" rpy="0 0 0"/>
</collision>
<inertial>
<mass value="${support_mass}"/>
<inertia ixx="${support_mass*(3*support_radius*support_radius + support_length*support_length)/12}"
ixy="0.0" ixz="0.0"
iyy="${support_mass*(3*support_radius*support_radius + support_length*support_length)/12}"
iyz="0.0"
izz="${support_mass*support_radius*support_radius/2}"/>
</inertial>
</link>
<joint name="support_joint" type="fixed">
<parent link="base_link"/>
<child link="support"/>
<origin xyz="0 0 ${base_length/2 + support_length/2}" rpy="0 0 0"/>
</joint>
<link name="laser">
<visual>
<geometry>
<cylinder radius="${laser_radius}" length="${laser_length}"/>
</geometry>
<origin xyz="0 0 0" rpy="0 0 0"/>
<material name="laser_color">
<color rgba="0.5 0.5 0.5 1.0"/>
</material>
</visual>
<collision>
<geometry>
<cylinder radius="${laser_radius}" length="${laser_length}"/>
</geometry>
<origin xyz="0 0 0" rpy="0 0 0"/>
</collision>
<inertial>
<mass value="${laser_mass}"/>
<inertia ixx="${laser_mass*(3*laser_radius*laser_radius + laser_length*laser_length)/12}"
ixy="0.0" ixz="0.0"
iyy="${laser_mass*(3*laser_radius*laser_radius + laser_length*laser_length)/12}"
iyz="0.0"
izz="${laser_mass*laser_radius*laser_radius/2}"/>
</inertial>
</link>
<joint name="laser_joint" type="fixed">
<parent link="support"/>
<child link="laser"/>
<origin xyz="0 0 ${support_length/2 + laser_length/2}" rpy="0 0 0"/>
</joint>
<gazebo reference="support">
<material>Gazebo/Orange</material>
</gazebo>
<gazebo reference="laser">
<sensor type="ray" name="laser_sensor">
<pose>0 0 0 0 0 0</pose>
<visualize>true</visualize>
<update_rate>10</update_rate>
<ray>
<scan>
<horizontal>
<samples>360</samples>
<resolution>1</resolution>
<min_angle>-3.14159</min_angle>
<max_angle>3.14159</max_angle>
</horizontal>
</scan>
<range>
<min>0.10</min>
<max>10.0</max>
<resolution>0.01</resolution>
</range>
</ray>
<plugin name="gazebo_ros_laser_controller" filename="libgazebo_ros_laser.so">
<topicName>/scan</topicName>
<frameName>laser</frameName>
</plugin>
</sensor>
</gazebo>

</xacro:macro>
