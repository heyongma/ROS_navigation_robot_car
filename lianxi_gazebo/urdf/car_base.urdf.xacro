<?xml version="1.0"?>
<xacro:macro name="car_base_block" xmlns:xacro="http://wiki.ros.org/xacro">
<xacro:property name="base_radius" value="0.12"/>
<xacro:property name="base_length" value="0.10"/>
<xacro:property name="base_mass" value="2.0"/>
<xacro:property name="wheel_radius" value="0.04"/>
<xacro:property name="wheel_length" value="0.02"/>
<xacro:property name="wheel_mass" value="0.15"/>
<xacro:property name="base_link_world_z" value="${wheel_radius + base_length / 2}"/>
<xacro:property name="wheel_local_z" value="${wheel_radius - base_link_world_z}"/>
<xacro:macro name="cylinder_inertial_matrix" params="m r h">
<inertial>
<mass value="${m}"/>
<inertia ixx="${m*(3*r*r + h*h)/12}" ixy="0.0" ixz="0.0"
iyy="${m*(3*r*r + h*h)/12}" iyz="0.0"
izz="${m*r*r/2}"/>
</inertial>
</xacro:macro>
<link name="base_footprint">
<visual>
<geometry>
<sphere radius="0.001"/>
</geometry>
</visual>
</link>
<joint name="base_link_joint" type="fixed">
<parent link="base_footprint"/>
<child link="base_link"/>
<origin xyz="0 0 ${base_link_world_z}" rpy="0 0 0"/>
</joint>
<link name="base_link">
<visual>
<geometry>
<cylinder radius="${base_radius}" length="${base_length}"/>
</geometry>
<origin xyz="0 0 0" rpy="0 0 0"/>
<material name="base_color">
<color rgba="0.8 0.2 0.2 1.0"/>
</material>
</visual>
<collision>
<geometry>
<cylinder radius="${base_radius}" length="${base_length}"/>
</geometry>
<origin xyz="0 0 0" rpy="0 0 0"/>
</collision>
<xacro:cylinder_inertial_matrix m="${base_mass}" r="${base_radius}" h="${base_length}"/>
</link>
<material name="wheel_color">
<color rgba="0.1 0.1 0.1 1.0"/>
</material>
<link name="left_wheel">
<visual>
<geometry>
<cylinder radius="${wheel_radius}" length="${wheel_length}"/>
</geometry>
<origin xyz="0 0 0" rpy="1.57075 0 0"/>
<material name="wheel_color"/>
</visual>
<collision>
<geometry>
<cylinder radius="${wheel_radius}" length="${wheel_length}"/>
</geometry>
<origin xyz="0 0 0" rpy="1.57075 0 0"/>
</collision>
<xacro:cylinder_inertial_matrix m="${wheel_mass}" r="${wheel_radius}" h="${wheel_length}"/>
</link>
<joint name="left_wheel_joint" type="continuous">
<parent link="base_link"/>
<child link="left_wheel"/>
<origin xyz="0 0.13 ${wheel_local_z}" rpy="0 0 0"/>
<axis xyz="0 1 0"/>
</joint>
<link name="right_wheel">
<visual>
<geometry>
<cylinder radius="${wheel_radius}" length="${wheel_length}"/>
</geometry>
<origin xyz="0 0 0" rpy="1.57075 0 0"/>
<material name="wheel_color"/>
</visual>
<collision>
<geometry>
<cylinder radius="${wheel_radius}" length="${wheel_length}"/>
</geometry>
<origin xyz="0 0 0" rpy="1.57075 0 0"/>
</collision>
<xacro:cylinder_inertial_matrix m="${wheel_mass}" r="${wheel_radius}" h="${wheel_length}"/>
</link>
<joint name="right_wheel_joint" type="continuous">
<parent link="base_link"/>
<child link="right_wheel"/>
<origin xyz="0 -0.13 ${wheel_local_z}" rpy="0 0 0"/>
<axis xyz="0 1 0"/>
</joint>
<link name="front_ball_caster">
<visual>
<geometry>
<sphere radius="${wheel_radius}"/>
</geometry>
<origin xyz="0 0 0" rpy="0 0 0"/>
<material name="wheel_color"/>
</visual>
<collision>
<geometry>
<sphere radius="${wheel_radius }"/>
</geometry>
<origin xyz="0 0 0" rpy="0 0 0"/>
</collision>
<inertial>
<mass value="${wheel_mass * 0.5}"/>
<inertia ixx="0.001" ixy="0.0" ixz="0.0"
iyy="0.001" iyz="0.0"
izz="0.001"/>
</inertial>
</link>
<joint name="front_ball_caster_joint" type="fixed">
<parent link="base_link"/>
<child link="front_ball_caster"/>
<origin xyz="0.12 0 ${wheel_local_z}" rpy="0 0 0"/>
</joint>
<link name="rear_ball_caster">
<visual>
<geometry>
<sphere radius="${wheel_radius}"/>
</geometry>
<origin xyz="0 0 0" rpy="0 0 0"/>
<material name="wheel_color"/>
</visual>
<collision>
<geometry>
<sphere radius="${wheel_radius}"/>
</geometry>
<origin xyz="0 0 0" rpy="0 0 0"/>
</collision>
<inertial>
<mass value="${wheel_mass * 0.5}"/>
<inertia ixx="0.001" ixy="0.0" ixz="0.0"
iyy="0.001" iyz="0.0"
izz="0.001"/>
</inertial>
</link>
<joint name="rear_ball_caster_joint" type="fixed">
<parent link="base_link"/>
<child link="rear_ball_caster"/>
<origin xyz="-0.12 0 ${wheel_local_z }" rpy="0 0 0"/>
</joint>

<!-- IMU link + joint 在这里补上 -->
<link name="imu_link">
<visual>
<geometry>
<box size="0.04 0.04 0.02"/>
</geometry>
<material name="base_color"/>
</visual>
<collision>
<geometry>
<box size="0.04 0.04 0.02"/>
</geometry>
</collision>
<inertial>
<mass value="0.01"/>
<inertia ixx="0.00001" ixy="0.0" ixz="0.0"
iyy="0.00001" iyz="0.0"
izz="0.00001"/>
</inertial>
</link>
<joint name="imu_joint" type="fixed">
<parent link="base_link"/>
<child link="imu_link"/>
<origin xyz="0 0 0.05" rpy="0 0 0"/>
</joint>

<gazebo>
<plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
<leftJoint>left_wheel_joint</leftJoint>
<rightJoint>right_wheel_joint</rightJoint>
<commandTopic>/cmd_vel</commandTopic>
<odometryTopic>/odom</odometryTopic>
<odometryFrame>odom</odometryFrame>
<robotBaseFrame>base_footprint</robotBaseFrame>
<publishTf>true</publishTf>
<publishOdomTF>true</publishOdomTF>
<publishWheelJointState>true</publishWheelJointState>
<wheelSeparation>0.26</wheelSeparation>
<wheelDiameter>0.08</wheelDiameter>
<wheelAcceleration>1.0</wheelAcceleration>
<wheelTorque>20</wheelTorque>
<updateRate>20</updateRate>
</plugin>
</gazebo>

<!-- 平级，正确 -->
<gazebo reference="imu_link">
<sensor name="imu_sensor" type="imu">
<always_on>true</always_on>
<update_rate>100</update_rate>
<visualize>false</visualize>
<plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
<topicName>/imu</topicName>
<frameName>imu_link</frameName>
<gaussianNoise>0.0001</gaussianNoise>
</plugin>
</sensor>
</gazebo>

</xacro:macro>
