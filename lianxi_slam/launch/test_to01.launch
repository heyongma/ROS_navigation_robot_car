<!-- test_to01.launch -->
<launch>
<!-- 选择局部规划器，默认dwa；启动传 planner:=teb 切换 -->
<arg name="planner" default="dwa"/>

<include file="$(find lianxi_slam)/launch/map_server01.launch" />
<include file="$(find lianxi_slam)/launch/cmal.launch" />

<!-- DWA -->
<include if="$(eval arg('planner') == 'dwa')" file="$(find lianxi_slam)/launch/move_base01.launch"/>
<!-- TEB -->
<include if="$(eval arg('planner') == 'teb')" file="$(find lianxi_slam)/launch/move_base_teb.launch"/>

<!-- robot_pose_ekf 融合节点 新增 -->
<!--
  <node pkg="robot_pose_ekf" type="robot_pose_ekf" name="robot_pose_ekf" output="screen">
  <rosparam file="$(find lianxi_slam)/param/ekf.yaml" command="load"/>
  </node>
  -->

<node pkg="rviz" type="rviz" name="rviz"/>
</launch>
